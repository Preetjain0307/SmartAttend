# SmartAttend Firebase Configuration
# Replace these with your Firebase Web project credentials if you want to use custom Web API keys.
# The databaseURL is already configured for your SmartAttend ESP8266 database.

VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForSmartAttendIoTProject
VITE_FIREBASE_AUTH_DOMAIN=smartattend-af03a.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://smartattend-af03a-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=smartattend-af03a
VITE_FIREBASE_STORAGE_BUCKET=smartattend-af03a.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456789
